Options -MultiViews
RewriteEngine On

RewriteBase /

# Forzar HTTPS: el SDK de pago de Square exige "secure context" y por http se niega a
# cargar ("Web Payments SDK can only be embedded on sites that use HTTPS").
#
# Se comprueban CUATRO señales porque en hosting con proxy TLS (IONOS) la petición puede
# llegar al Apache como http aunque el visitante venga por https. Si solo se mirara
# %{HTTPS} el redirect se dispararía en bucle infinito y tumbaría el sitio entero.
# Si tras desplegar vieras "demasiadas redirecciones", comenta este bloque y avisa.
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} !=443
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-SSL} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Bloquear acceso público directo a logs, cookies de sesión y archivos de config.
# Estos archivos los lee/escribe proxy.php internamente (filesystem), nunca deben
# servirse por HTTP: pba_cookies.txt es la sesión Sanctum contra Laravel, y los .log
# pueden contener cuerpos de petición completos (tokens de pago, datos de contacto).
<FilesMatch "\.(log|txt)$|^pba_cookies">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(log|txt)$|^pba_cookies">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# CSP: se limita a los orígenes que la app usa de verdad (jsDelivr para Bootstrap,
# Google Fonts, Square y PayPal). Se mantienen 'unsafe-inline'/'unsafe-eval' porque
# los SDK de pago los necesitan; lo que se cierra es que valga CUALQUIER origen, que
# es lo que convertía un XSS o un CDN comprometido en robo de tarjetas.
# Si algún día se rompe la pasarela tras un cambio de Square/PayPal, el fallo saldrá
# en la consola del navegador como "Refused to load ..." y solo hay que añadir el
# dominio que falte a la directiva correspondiente.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://web.squarecdn.com https://js.squareup.com https://www.paypal.com https://www.paypalobjects.com https://*.paypal.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://web.squarecdn.com https://*.squarecdn.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://web.squarecdn.com https://*.squarecdn.com https://d1g145x70srn7h.cloudfront.net; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net https://connect.squareup.com https://pci-connect.squareup.com https://*.squareup.com https://*.squarecdn.com https://api-m.paypal.com https://api-m.sandbox.paypal.com https://www.paypal.com https://*.paypal.com; frame-src https://web.squarecdn.com https://*.squareup.com https://www.paypal.com https://*.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

# Cabeceras de seguridad que faltaban
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# HSTS solo cuando la petición llega por HTTPS (si no, no tiene efecto y evita dejar
# clavado el sitio en https si alguien lo sirve por http en pruebas). Se usa SetEnvIf
# en vez de <If> porque <If> solo existe en Apache 2.4 y rompería con un 500 en 2.2.
<IfModule mod_setenvif.c>
    SetEnvIf HTTPS on PBH_HTTPS
</IfModule>
Header always set Strict-Transport-Security "max-age=15552000" env=PBH_HTTPS

# ¡IMPORTANTE! Las reglas de API DEBEN ir ANTES de la regla de archivos/directorios reales
# Porque /config/ es una carpeta real que existe, Apache la ve como directorio
# y no la reescribe si la regla de archivos/directorios reales viene primero

# Config endpoints - ANTES que "archivos reales"
RewriteRule ^config/?$ /proxy.php [PT,L,QSA]

# Login/sesión de hotel
RewriteRule ^auth/.*$ /proxy.php [PT,L,QSA]

# Logo del hotel (GET sirve, POST guarda en config/hotels/<id>/)
RewriteRule ^hotel-logo/?$ /proxy.php [PT,L,QSA]

# Payment endpoint
RewriteRule ^process-payment/?$ /proxy.php [PT,L,QSA]

# APIs y proxy
RewriteRule ^health$ /proxy.php [PT,L,QSA]
RewriteRule ^print/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^printbox/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^proxy-image/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^paypal/.*$ /proxy.php [PT,L,QSA]

# Coupon endpoints (generación, validación, canje y listado)
RewriteRule ^coupon/create$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/validate$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/redeem$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/list$ /proxy.php [PT,L,QSA]

# AHORA sí, permitir archivos y directorios reales (index.html, CSS, JS, imágenes, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router: todo lo demás a index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]